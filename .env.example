# ---------- required ----------
ENVIRONMENT=production
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
POSTGRES_PASSWORD=change-me
POSTGRES_USER=lifeos
POSTGRES_DB=lifeos

# Public URL of the web app (used in email links and OAuth redirects)
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Set to true when served over HTTPS
COOKIE_SECURE=false
WEB_PORT=3000

# ---------- local (non-docker) only ----------
# DATABASE_URL=postgresql+psycopg://lifeos:lifeos@localhost:5432/lifeos
# REDIS_URL=redis://localhost:6379/0

# ---------- optional: email (password reset, verification, email reminders) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=LIFE OS <no-reply@example.com>
SMTP_TLS=true

# ---------- optional: Web Push (generate with: npx web-push generate-vapid-keys) ----------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---------- optional: AI assistant (keys stay on the server) ----------
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Google Gemini (key from aistudio.google.com); AI_PROVIDER=auto uses whichever key is set
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ---------- optional: Google Calendar ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: defaults to {FRONTEND_URL}/api/v1/integrations/google/callback
GOOGLE_REDIRECT_URI=
# Two-way calendar sync interval (Google + Apple iCloud/CalDAV), minutes
CALENDAR_SYNC_MINUTES=15
# Allow CalDAV servers on private/localhost addresses (only for local testing)
CALDAV_ALLOW_PRIVATE_HOSTS=false

# ---------- limits ----------
MAX_UPLOAD_MB=15
RATE_LIMIT_AUTH=20
RATE_LIMIT_AI=20
